      <aliases enabled='yes' />
      <column caption='IsReturn' datatype='string' name='[Calculation_1115485344965943296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LEFT(STR([invoice_no]),1)=&quot;C&quot; OR [quantity] &lt; 0 THEN &quot;Return&quot; ELSE &quot;Sale&quot; END' />
      </column>
      <column caption='Order Revenue' datatype='real' name='[Calculation_1155173316717068288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [invoice_no] : SUM([total_price]) }' />
      </column>
      <column caption='Order Quantity' datatype='integer' name='[Calculation_1155173316717256705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [invoice_no] : SUM([quantity]) }' />
      </column>
      <column caption='Max Date' datatype='datetime' name='[Calculation_1155173316721565698]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([invoice_date]) }' />
      </column>
      <column caption='Blank' datatype='string' name='[Calculation_633881660554633216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='Cost' datatype='real' name='[Calculation_633881660573855745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[unit_price] * [quantity] * 0.60' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_633881660573921282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_price] - [Calculation_633881660573855745]' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_925489736077840384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price])/ COUNTD([invoice_no])' />
      </column>
      <column caption='Average Items Per Order' datatype='real' name='[Calculation_925489736078934017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ FIXED [invoice_no] : SUM([quantity]) })' />
      </column>
      <column caption='Country_updated' datatype='string' name='[Calculation_99923630671024128]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [country] = &quot;EIRE&quot; THEN &quot;Ireland&quot;&#13;&#10;ELSE [country]&#13;&#10;END' />
      </column>
      <column aggregation='None' datatype='integer' name='[Total Price (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='3' formula='[total_price]' peg='0' size='3617' />
      </column>
