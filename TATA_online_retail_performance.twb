  <worksheets>
    <worksheet name='Product Table'>
      <repository-location derived-from='https://public.tableau.com/workbooks/TATA_online_retail_performance/ProductTable?rev=' id='124676239' path='/workbooks/TATA_online_retail_performance' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_retail_data' name='federated.19g5xrf0xwtig117x88010y3lnbv' />
          </datasources>
          <datasource-dependencies datasource='federated.19g5xrf0xwtig117x88010y3lnbv'>
            <column caption='Order Quantity' datatype='integer' name='[Calculation_1155173316717256705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [invoice_no] : SUM([quantity]) }' />
            </column>
            <column caption='Cost' datatype='real' name='[Calculation_633881660573855745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[unit_price] * [quantity] * 0.60' />
            </column>
            <column caption='Profit' datatype='real' name='[Calculation_633881660573921282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_price] - [Calculation_633881660573855745]' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
